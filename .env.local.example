# Copy this file to .env.local and fill in your Supabase credentials.
# Find these in: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Public HTTPS origin used for auth callback redirects behind the RunCloud proxy.
NEXT_PUBLIC_SITE_URL=https://planner.example.com

# --- Competency API (public, agent-facing) ---
# Service-role key: server-only secret used by /api/* route handlers. It BYPASSES
# Row Level Security, so it must never be exposed to the browser (no NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Comma-separated list of valid API keys. External callers (and the MCP server)
# authenticate with:  Authorization: Bearer <one-of-these-keys>
COMPETENCY_API_KEYS=generate-a-long-random-key,another-optional-key

# RunCloud process port (Next.js defaults to 3000 when omitted).
PORT=3000
