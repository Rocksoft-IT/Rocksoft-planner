# Copy this file to .env.local and fill in your Supabase credentials.
# Find these in: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Competency API (public, agent-facing) ---
# Server-only key: legacy service_role or a modern sb_secret_* key.
# Used by /api/* route handlers. It BYPASSES
# Row Level Security, so it must never be exposed to the browser (no NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Comma-separated list of valid API keys. External callers (and the MCP server)
# authenticate with:  Authorization: Bearer <one-of-these-keys>
COMPETENCY_API_KEYS=generate-a-long-random-key,another-optional-key

# --- Entra ID contract sync (server-only) ---
# App registration requires Microsoft Graph application User.Read.All + admin consent.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Confirmed contract attribute for the Rocksoft directory.
ENTRA_CONTRACT_ATTRIBUTE=employeeType
# Polish contract values are mapped automatically; '-' means no contract.
# Optional mapping: targets are CONTRACT_TYPES (src/lib/types.ts), or null.
# ENTRA_CONTRACT_VALUE_MAP={"Employment":"UoP","Contractor":"B2B"}
# Dedicated scheduler secret; scripts/sync-entra.mjs sends it in Authorization.
CRON_SECRET=
# Optional URL for the RunCloud cron script. A command-line URL takes precedence.
# ENTRA_SYNC_URL=https://planner.example.com
