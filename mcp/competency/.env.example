# RS Planner Competency MCP server — configuration
#
# Base URL of the deployed RS Planner app (do NOT include a trailing slash or /api).
# The server appends /api/... itself.
COMPETENCY_API_BASE_URL=https://your-rockplanner-deployment.example.com

# One of the API keys configured on the server in COMPETENCY_API_KEYS.
COMPETENCY_API_KEY=replace-with-a-valid-api-key
